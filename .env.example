# Copy this file to .env and choose one provider. Never commit .env.
AI_PROVIDER=openrouter

# Used only when AI_PROVIDER=gemini.
GEMINI_API_KEY=replace_with_your_api_key

# Lower-cost Google model. The model must support Google Search grounding.
GEMINI_MODEL=gemini-3.1-flash-lite
# Gemini's separate final evidence reviewer (not used with OpenRouter).
GEMINI_REVIEW_MODEL=gemini-3-flash-preview

# Used only when AI_PROVIDER=openrouter. Get a key from openrouter.ai/keys.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
# Same economical model for review; change only after measuring quality/cost.
OPENROUTER_REVIEW_MODEL=google/gemini-3-flash-preview
# Application budget guard (USD), maximum research rounds, recent-report reuse.
# Also set a spending limit on the API key in OpenRouter for a provider-enforced cap.
OPENROUTER_MAX_RUN_COST_USD=0.03
RESEARCH_MAX_ROUNDS=2
REPORT_CACHE_MINUTES=15
# Output allowances include model reasoning + the complete structured response,
# not just the short email. These are ceilings, not tokens charged automatically.
OPENROUTER_RESEARCH_MAX_TOKENS=2400
OPENROUTER_REPORT_MAX_TOKENS=4096
OPENROUTER_RECOVERY_MAX_TOKENS=8192
# At most ONE extra length-recovery call for the whole run, within the same USD guard.
OPENROUTER_MAX_LENGTH_RETRIES=1
# Sent only when the model advertises reasoning support. Use provider_default to omit.
OPENROUTER_REASONING_EFFORT=low

# Optional source preferences; these guide research but cannot guarantee coverage.
PREFERRED_SOURCES=RBA,ABC,Reuters,AFR

# Email is sent only after a live report succeeds and you request sending.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
# Optional email display name and subject title. Subject becomes "Title: news topic".
EMAIL_SENDER_NAME=AI News Research Agent
EMAIL_SUBJECT_TITLE=News Update
